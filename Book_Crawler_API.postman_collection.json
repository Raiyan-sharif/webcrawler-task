{
	"info": {
		"_postman_id": "book-crawler-api",
		"name": "Book Crawler API",
		"description": "API collection for testing the Book Crawler endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Create API Key",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/create-key?name=TestKey",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"create-key"
							],
							"query": [
								{
									"key": "name",
									"value": "TestKey"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Books",
			"item": [
				{
					"name": "Get All Books",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/books",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"books"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Books with Filters",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/books?category=Science&min_price=10&max_price=50&rating=Four&sort_by=price_including_tax&sort_order=desc&page=1&page_size=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"books"
							],
							"query": [
								{
									"key": "category",
									"value": "Science"
								},
								{
									"key": "min_price",
									"value": "10"
								},
								{
									"key": "max_price",
									"value": "50"
								},
								{
									"key": "rating",
									"value": "Four"
								},
								{
									"key": "sort_by",
									"value": "price_including_tax"
								},
								{
									"key": "sort_order",
									"value": "desc"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "page_size",
									"value": "10"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Book by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/books/{{book_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"books",
								"{{book_id}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Changes",
			"item": [
				{
					"name": "Get Recent Changes",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/changes?days=7&page=1&page_size=20",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"changes"
							],
							"query": [
								{
									"key": "days",
									"value": "7"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "page_size",
									"value": "20"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Changes Summary",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/changes/summary?days=7",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"changes",
								"summary"
							],
							"query": [
								{
									"key": "days",
									"value": "7"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"health"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "api_key",
			"value": "your-api-key-here",
			"type": "string"
		},
		{
			"key": "book_id",
			"value": "your-book-id-here",
			"type": "string"
		}
	]
}
