# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=book_crawler

# API Configuration
API_SECRET_KEY=your-secret-key-here
API_RATE_LIMIT=100
API_RATE_WINDOW=3600

# Crawler Configuration
CRAWLER_BASE_URL=https://books.toscrape.com
CRAWLER_MAX_RETRIES=3
CRAWLER_RETRY_DELAY=1
CRAWLER_CONCURRENT_REQUESTS=10
CRAWLER_REQUEST_DELAY=0.5

# Scheduler Configuration
SCHEDULER_TIMEZONE=UTC
SCHEDULER_DAILY_TIME=02:00

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/crawler.log

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=raiyan.sharif.1234@gmail.com
SMTP_PASSWORD=Asdf1234@
ALERT_EMAIL=admin@filerskeepers.co
